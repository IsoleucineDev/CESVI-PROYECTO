// ─────────────────────────────────────────────────────────────────────────────
// TRAIT: genera UUID automáticamente al crear un registro
// Aplica a: Incidente, UbicacionVia, Vehiculo, IncidenteVehiculo, Reporte
// ─────────────────────────────────────────────────────────────────────────────
trait HasUuid
{
    protected static function bootHasUuid(): void
    {
        static::creating(function (Model $model) {
            $model->uuid ??= (string) Str::uuid();
        });
    }

    /** Busca por UUID público sin exponer el id interno */
    public static function findByUuid(string $uuid): ?static
    {
        return static::where('uuid', $uuid)->first();
    }

    /** Devuelve el UUID como clave de ruta (para Route Model Binding) */
    public function getRouteKeyName(): string
    {
        return 'uuid';
    }
}

